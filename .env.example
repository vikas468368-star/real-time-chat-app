# PulseChat Environment Configuration
# Copy this file to .env and set your secrets before running the application

# Strong random secret key for session encryption
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Database Connection (SQLite default, PostgreSQL for production)
DATABASE_URL=sqlite:///chat.db

# Flask environment: "development" or "production"
FLASK_ENV=development

# Server Port (default 5000)
PORT=5000
